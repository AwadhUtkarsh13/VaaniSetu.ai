# Copy to .env and fill in. Only OPENAI_API_KEY is required. Never share or commit .env.

# --- AI (required) ----------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini            # routing, detail extraction, grounded answers
# OPENAI_SMALL_MODEL=gpt-4o-mini       # confirmations, summaries, translation
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Voice (works out of the box with the OpenAI key) -----------------------
# SPEECH_PROVIDER=openai               # or "bhashini" (needs the two keys below)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# Optional Bhashini (Government of India): https://bhashini.gov.in/ulca -> My Profile -> API key
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- Email: verification codes and password resets (Gmail) -------------------
# Without these, codes are printed in the server window instead of emailed.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Example: SMTP_USERNAME=you@gmail.com  SMTP_FROM=VaaniSetu AI <you@gmail.com>

# --- Replies -------------------------------------------------------------------
# auto = reply in the language the citizen writes in (Hinglish in -> Hinglish out)
DEFAULT_LANGUAGE=auto

# --- Retrieval tuning (defaults shown) ------------------------------------------
# QDRANT_URL=http://localhost:6333     # use a Qdrant server instead of ./qdrant_data
# RETRIEVAL_TOP_K=8
# RRF_K=60
# PII_SCORE_THRESHOLD=0.5

# --- Web app (defaults shown) -----------------------------------------------------
# PORT=8000
# SESSION_DAYS=14
# COOKIE_SECURE=false                  # set true when served over HTTPS
